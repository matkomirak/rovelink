# Private local configuration template for v0.1.0-alpha.
# Copy to .env and replace required placeholders. Never commit that private file.
# This is not a production deployment configuration.
# Host commands must explicitly load .env; see README.md.
# Compose also reads .env, but overrides some values (including local-dev mode).

# Required database connection for HOST development.
# Provision a host-reachable Postgres database and replace user/password.
# For the bundled Compose DB, OMIT DATABASE_URL from .env to use its internal URL.
DATABASE_URL=postgresql://replace_user:replace_password@localhost:5432/rovelink
# pg for ordinary Postgres; omit for the Neon client.
DATABASE_CLIENT=pg
PORT=5000

# Generate separate random secrets locally, e.g. openssl rand -hex 32.
# These placeholders are not usable secrets.
SESSION_SECRET=replace_with_random_session_secret
JWT_SECRET=replace_with_random_jwt_secret

# Required AES-256-GCM key: replace with exactly 64 hex characters (32 bytes).
# Keep it stable for existing encrypted records; changing it requires a migration.
ENCRYPTION_KEY=replace_with_64_random_hex_characters

# Bootstrap seed creates this user only if it does not exist.
BOOTSTRAP_ADMIN_USER=admin
# Blank generates credentials displayed once during setup. Store them securely.
# Use a strong password if setting this explicitly.
BOOTSTRAP_ADMIN_PASSWORD=
# Local-only weak-secret/bootstrap exemption. Never enable for production.
# Compose currently sets this to true independently of this template.
ROVELINK_LOCAL_DEV=false

# Optional default NetBox connection. Leave blank unless testing that integration.
# Configure only a disposable local/test instance; credentials are sensitive.
NETBOX_URL=
NETBOX_TOKEN=

# Provider credentials are configured through provider accounts in the app.
# Azure uses subscription_id, tenant_id, client_id, client_secret.
# Proxmox uses base_url, auth_method, and auth-specific credentials.
# There are no Azure/Proxmox environment credential variables in this template.
# Never put real provider credentials, tenant IDs, or subscription IDs in Git.

# Approved HTTPS Git hosts for project sync; required in production.
ROVELINK_GIT_ALLOWED_HOSTS=github.com
# Optional server-managed checkout root. Leave unset to use the built-in default.
# ROVELINK_PROJECTS_ROOT=.local/git-projects

# Production local execution requires explicit opt-in; development also permits it.
# Execute only trusted playbooks against dedicated test targets.
ROVELINK_LOCAL_RUNNER_ENABLED=false
ROVELINK_LOCAL_RUNNER_TIMEOUT_MS=600000
ROVELINK_LOCAL_RUNNER_MAX_OUTPUT_BYTES=1048576

# CustomerScope demo seed is opt-in and writes synthetic records to Rovelink's DB.
# Run only against a disposable demo database. Never use customer data.
ROVELINK_DEMO_DATA=false
# Optional IDs printed/selected locally; unset uses the seed's default selection.
# ROVELINK_DEMO_ORG_ID=replace_with_local_demo_org_id
# ROVELINK_DEMO_CMDB_ID=replace_with_local_demo_cmdb_id

# Compose database only: replace locally; not a usable default password.
DB_PASSWORD=replace_with_local_database_password

# Local NetBox provisioning/seeding uses the separate .env.netbox.example.
# AWX execution is outside the current alpha MVP; no AWX setup is required.
