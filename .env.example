# Database connection
DATABASE_URL=postgresql://bridge:bridgepass@localhost:5432/bridge_db

# Server port
PORT=5000

# JWT secret for authentication (change in production!)
JWT_SECRET=change-me-in-production

# Session secret (change in production!)
SESSION_SECRET=change-me-in-production

# Optional: Disable authentication for testing (true/false)
# AUTH_DISABLE=false

# Optional: NetBox configuration (can also be configured via UI)
# NETBOX_URL=https://demo.netbox.dev
# NETBOX_TOKEN=your-token-here
