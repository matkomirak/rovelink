# Copy to .env.netbox before starting the optional local NetBox stack.
# Values below are development placeholders only; replace them locally.

NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
NETBOX_DB_PASSWORD=change-me-local-netbox-db-password

# Generate locally for real use, for example:
# python -c "import secrets; print(secrets.token_urlsafe(60))"
NETBOX_SECRET_KEY=change-me-local-netbox-secret-key-at-least-50-characters
NETBOX_API_TOKEN_PEPPER_1=change-me-local-netbox-api-token-pepper-at-least-50-characters

NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@example.com
NETBOX_SUPERUSER_PASSWORD=change-me-local-netbox-admin-password
NETBOX_SUPERUSER_API_TOKEN=change-me-local-netbox-api-token

NETBOX_ALLOWED_HOSTS=localhost 127.0.0.1 host.docker.internal
